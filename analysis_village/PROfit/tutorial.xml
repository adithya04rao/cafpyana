<?xml version="1.0" ?>

<!-- One mode and Single Detector Analysis -->
<mode name="nu" />
<detector name="SBND" pot="1e20"/>

<!--Single Channel : Numu Selcetion-->
<channel name="numu" plotname="SPINE CC #nu_{#mu} Selection">
    <bins unit="Reconstructed Neutrino Energy [GeV]" edges="0.3 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0 1.25 1.5 2.0 2.5"/>
    <bins unit="True Neutrino Energy [GeV]" min="0" max="3" nbins="20"/>
    <bins unit="True L/E [km/GeV]" min="0" max="3" nbins="150" plot="false"/>
    <subchannel name="intime" plotname="Intime Cosmics" color="#FBBC04"/>
    <subchannel name="cos"    plotname="Cosmics"        color="#E37400"/>
    <subchannel name="nc"     plotname="NC"             color="#FF6961"/>
    <subchannel name="nuecc"  plotname="#nu_{e} CC"     color="#34A853"/>
    <subchannel name="numucc" plotname="#nu_{#mu} CC"   color="#99CCFF"/>
</channel>

<!-- The Physics model to fit, here numu disapearance only-->
<model tag="numudis">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="Numu Dis"/>
    <parameter name="L/E" variable_index="1"/>
</model>

<!-- Where to find the Montecarlo and how to fill all the subchannels defined above-->
<MCFile treename="SelectedEvents" filename="/home/arao/muNp0pidf_sBruce.root" scale = "1.0" pot="8.10889473828984e+19"> 
    <friend treename="multisigmaTree"/>
    <friend treename="multisimTree"/>
    <branch
        associated_subchannel = "nu_SBND_numu_numucc"
        model_rule            = "1"
        additional_weight     = "true_cc * (pfp_trk_truth_p_interaction_id >= 0)"
    >
        <variable>slc_reco_nu_E</variable>
        <variable>slc_truth_E</variable>
        <variable>slc_truth_baseline/(1000*slc_truth_E)</variable>
    </branch>
</MCFile>
