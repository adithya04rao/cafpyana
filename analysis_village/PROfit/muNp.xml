    <systematic type="spline" binning="var1" plotname="MaNCRES" tag="Cross-Section-I">GENIEReWeight_SBN_v1_multisigma_MaNCRES</systematic>
    <systematic type="spline" binning="var1" plotname="MvCCRES" tag="Cross-Section-I">GENIEReWeight_SBN_v1_multisigma_MvCCRES</systematic>
    <systematic type="spline" binning="var1" plotname="MvNCRES" tag="Cross-Section-I">GENIEReWeight_SBN_v1_multisigma_MvNCRES</systematic>
    <systematic type="spline" binning="var1" plotname="RDecBR1gamma" tag="Cross-Section-I">GENIEReWeight_SBN_v1_multisigma_RDecBR1gamma</systematic>
