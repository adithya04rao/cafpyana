<MCFile treename="SelectedEvents" filename="/scratch/nrowe/new_processing/SBND_SpringMC_rewgt_B_*sbruce.root" scale = "1.0" pot="5.616e20">
    <friend treename="multisigmaTree" />
    <friend treename="multisimTree" />
    <branch
        associated_subchannel = "nu_SBND_numu_cc"
        model_rule            = "1"
        additional_weight     = "(!true_isnc)*(true_pdg == 14 || true_pdg == -14)*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
        <variable>baseline/(nu_E_true*1000.0)</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_numu_numunc"
        model_rule            = "1"
        additional_weight     = "(true_isnc == 1)*(true_pdg == 14 || true_pdg == -14)*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>baseline/(nu_E_true*1000.0)</variable>
    </branch>

    <branch
        associated_subchannel = "nu_SBND_numu_othernc"
        model_rule            = "0"
        additional_weight     = "(true_isnc == 1)*(true_pdg != 14 & true_pdg != -14)*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>baseline/(nu_E_true*1000.0)</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_numu_bkg"
        model_rule            = "0"
        additional_weight     = "(!((true_isnc != 1)*(true_pdg == 14 || true_pdg == -14)) & !(true_isnc == 1))*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>1.0</variable>
    </branch>
</MCFile>

