<?xml version="1.0" ?>

<mode name="nu" />

<detector name="SBND" pot="1e20"/>
<detector name="ICARUSRun2" pot="2e20"/>
<detector name="ICARUSRun4" pot="3e20"/>

<channel name="numu" unit="Reconstructed Neutrino Energy [GeV]">
    <bins2D unit="RecoE;del_p" edgesx="0.3 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0 1.25 1.5" edgesy="0.0 0.2 0.4 0.6"/>
    <bins unit = "True L/E" min="0" max="2.5" nbins="200" plot="false"/>
    <subchannel name="cc" plotname="#nu_{#mu}CC" color="#1e3f54"/>
    <subchannel name="numunc" plotname="NuMuNC" color="#95af8b"/>
    <subchannel name="othernc" plotname="OtherNC" color="#A4459F"/>
    <subchannel name="bkg" plotname="Other" color="#c89648"/>
    <subchannel name="intime" plotname="In Time Cosmics" color="#500000"/>
    <subchannel name="dirt" plotname="Dirt" color="#CC5500"/>
</channel>

<model tag="numudis">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="Numu Disapp"/>
    <parameter variable_index = "1" name="L/E"/>
</model>

